{
  "name": "openqq",
  "version": "0.1.0",
  "description": "OneBot v11 bridge for Windows & Linux QQ NT with a C++ native bootstrap",
  "keywords": [
    "onebot",
    "onebot-v11",
    "qq",
    "qqnt",
    "bot"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feijx3/OpenQQ.git"
  },
  "homepage": "https://github.com/feijx3/OpenQQ#readme",
  "bugs": {
    "url": "https://github.com/feijx3/OpenQQ/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:native && node ui/build.mjs",
    "release": "node scripts/release.mjs",
    "prestart": "npm run build",
    "prewebui": "npm run build",
    "init": "node src/main.mjs init",
    "bot": "node examples/bot.mjs",
    "doctor": "node src/main.mjs doctor",
    "start": "node src/main.mjs start",
    "webui": "node src/main.mjs webui",
    "pretest": "npm run build",
    "test": "node --test",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "npm run build:native && node --test test/native-bootstrap.test.mjs",
    "typecheck": "tsc -p ui"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "zustand": "^5.1.0"
  },
  "optionalDependencies": {
    "silk-wasm": "^3.7.1"
  }
}
